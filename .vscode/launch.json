{
  "configurations": [
    {
      "name": "Echo Server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/examples/echo-server/server.exe",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${fileDirname}",
      "externalConsole": false,
      "MIMode": "lldb",
      "environment": [
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${workspaceFolder}/src/:${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "DYLD_LIBRARY_PATH",
          "value": "${workspaceFolder}/src/:${env:DYLD_LIBRARY_PATH}"
        }
      ],
      "additionalSOLibSearchPath": "${workspaceFolder}/src/"
    },
    {
      "name": "futures",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src/async_futures.exe",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "lldb"
    },
    
  ]
}
